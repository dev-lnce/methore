# METHORE Frontend Environment Configuration Template

# Data Mode Switch
# - 'true': Standalone mock mode backed by localStorage (zero backend dependency)
# - 'false': Live REST mode connecting to Express + SQLite backend
VITE_USE_MOCK=true

# Backend REST API Base URL (used when VITE_USE_MOCK=false)
VITE_API_BASE_URL=http://localhost:4000/api
